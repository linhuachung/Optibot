# Never commit the real .env. Gemini uses GEMINI_API_KEY then API_KEY.
# OpenAI rollback uses API_KEY then OPENAI_API_KEY.
API_KEY=
OPENAI_API_KEY=
# Optional: leave blank to create and persist one store on the first upload.
OPENAI_VECTOR_STORE_ID=
# Set to a Responses model available to your project that supports file_search.
OPENAI_MODEL=
DATA_DIR=data
# Optional for main.py; takes precedence over DATA_DIR. Docker defaults to /data.
STATE_DIR=

# Select gemini for the migrated provider; openai is retained for rollback.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional; otherwise the created/reused Gemini store is saved in gemini-state.json.
GEMINI_FILE_SEARCH_STORE=
# Add a newly created private Gemini key locally; never reuse a key posted in chat.
GEMINI_API_KEY=
